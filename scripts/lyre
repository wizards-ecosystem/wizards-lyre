#!/usr/bin/env bash
# Wizard's Lyre local launcher. Run this instead of invoking Python, npm, or
# ACE-Step directly so all writable state stays under this checkout.
set -euo pipefail

ROOT="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"
ACE_DIR="$ROOT/vendor/ACE-Step-1.5"
ACE_SECURITY_OVERRIDES="$ROOT/requirements/ace-step-security.txt"
ACE_REPOSITORY="https://github.com/ACE-Step/ACE-Step-1.5.git"
ACE_REVISION="$(tr -d '\n' < "$ROOT/ACE_STEP_REVISION")"

if [[ ! "$ACE_REVISION" =~ ^[0-9a-f]{40}$ ]]; then
  echo "ACE_STEP_REVISION must contain one 40-character Git commit ID." >&2
  exit 1
fi

prepare_environment() {
  mkdir -p \
    "$ROOT/.cache/uv" "$ROOT/.cache/npm" "$ROOT/.cache/huggingface" \
    "$ROOT/.cache/modelscope" "$ROOT/.cache/torch" "$ROOT/.cache/cuda" \
    "$ROOT/.cache/triton" "$ROOT/.cache/numba" "$ROOT/.cache/pycache" \
    "$ROOT/.config" "$ROOT/.data" "$ROOT/.tmp" "$ROOT/.tools/python" \
    "$ROOT/checkpoints" "$ROOT/projects" "$ROOT/output"

  # Package managers, model libraries, compilers, and Python bytecode.
  export UV_CACHE_DIR="$ROOT/.cache/uv"
  export UV_PYTHON_INSTALL_DIR="$ROOT/.tools/python"
  export PIP_CACHE_DIR="$ROOT/.cache/pip"
  export npm_config_cache="$ROOT/.cache/npm"
  export NPM_CONFIG_USERCONFIG="$ROOT/.config/npmrc"
  export XDG_CACHE_HOME="$ROOT/.cache"
  export XDG_CONFIG_HOME="$ROOT/.config"
  export XDG_DATA_HOME="$ROOT/.data"
  export HF_HOME="$ROOT/.cache/huggingface"
  export HUGGINGFACE_HUB_CACHE="$ROOT/.cache/huggingface/hub"
  export HF_ASSETS_CACHE="$ROOT/.cache/huggingface/assets"
  export MODELSCOPE_CACHE="$ROOT/.cache/modelscope"
  export TORCH_HOME="$ROOT/.cache/torch"
  export CUDA_CACHE_PATH="$ROOT/.cache/cuda"
  export TRITON_CACHE_DIR="$ROOT/.cache/triton"
  export TORCHINDUCTOR_CACHE_DIR="$ROOT/.cache/torchinductor"
  export TORCH_EXTENSIONS_DIR="$ROOT/.cache/torch-extensions"
  export NUMBA_CACHE_DIR="$ROOT/.cache/numba"
  export MPLCONFIGDIR="$ROOT/.cache/matplotlib"
  export PYTHONPYCACHEPREFIX="$ROOT/.cache/pycache"
  export TMPDIR="$ROOT/.tmp"
  export TMP="$ROOT/.tmp"
  export TEMP="$ROOT/.tmp"

  # Lyre and ACE-Step model/runtime state. The two checkpoint variables serve
  # Lyre's worker and ACE-Step's downloader/handlers, respectively.
  export LYRE_PROJECTS_DIR="$ROOT/projects"
  export LYRE_OUTPUT_DIR="$ROOT/output"
  export LYRE_DB_PATH="$ROOT/projects/lyre.db"
  export LYRE_CHECKPOINTS_DIR="$ROOT/checkpoints"
  export ACESTEP_PROJECT_ROOT="$ROOT"
  export ACESTEP_CHECKPOINTS_DIR="$ROOT/checkpoints"

  # Ignore a user's npm configuration without making a new global config.
  touch "$NPM_CONFIG_USERCONFIG"
}

need_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required system tool: $1" >&2
    exit 1
  fi
}

need_node() {
  need_command node
  need_command npm

  local version major minor
  version="$(node --version)"
  version="${version#v}"
  IFS=. read -r major minor _ <<<"$version"
  if ((major == 20 && minor >= 19)) || ((major == 22 && minor >= 12)) || ((major > 22)); then
    return
  fi

  echo "Node.js 20.19+ or 22.12+ is required; found $version." >&2
  exit 1
}

ensure_venv() {
  need_command uv
  if [[ ! -x "$VENV/bin/python" ]]; then
    # uv downloads a managed Python into .tools/python if necessary.
    uv venv --python 3.12 "$VENV"
  fi
}

ensure_ace_source() {
  need_command git
  if [[ ! -d "$ACE_DIR/.git" ]]; then
    mkdir -p "$(dirname -- "$ACE_DIR")"
    git clone "$ACE_REPOSITORY" "$ACE_DIR"
  fi
  if ! git -C "$ACE_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "ACE-Step source at $ACE_DIR is not a Git checkout." >&2
    exit 1
  fi
  if [[ "$(git -C "$ACE_DIR" rev-parse HEAD)" != "$ACE_REVISION" ]]; then
    # Ignore untracked upstream cache files but never overwrite a tracked
    # source modification the user made under vendor/.
    if [[ -n "$(git -C "$ACE_DIR" status --porcelain --untracked-files=no)" ]]; then
      echo "ACE-Step source at $ACE_DIR has local changes; refusing to overwrite it." >&2
      exit 1
    fi
    git -C "$ACE_DIR" fetch --depth=1 origin "$ACE_REVISION"
    git -C "$ACE_DIR" checkout --detach "$ACE_REVISION"
  fi
}

install_dependencies() {
  ensure_venv
  # Lyre runs straight from this checkout, so it is deliberately not installed
  # as an editable package and no root-level *.egg-info is generated.
  (
    cd "$ROOT"
    # shellcheck disable=SC1091
    # This path is created by ensure_venv above.
    source "$VENV/bin/activate"
    # Preserve the pinned ACE-Step environment on repeat installs. Without
    # --inexact, this first sync removes the GPU stack as "extraneous" only
    # for the second sync below to install it again.
    uv sync --active --extra dev --no-install-project --locked --inexact
    # Keep Lyre's test dependencies while adding ACE-Step to this same local
    # environment. ACE-Step's own checked-in lock controls its dependencies.
    uv sync --project "$ACE_DIR" --active --inexact --locked
    # Upstream pins a full demo application environment. Lyre does not use its
    # Gradio UI, and several shared versions have published fixes. Remove the
    # unused UI and apply Lyre's exact, tested security overlay last.
    uv pip uninstall --python "$VENV/bin/python" gradio gradio-client
    uv pip install --python "$VENV/bin/python" --requirement "$ACE_SECURITY_OVERRIDES"
  )
}

install_web() {
  need_node
  npm --prefix "$ROOT/web" ci
  npm --prefix "$ROOT/web" run build
}

require_downloader() {
  if [[ ! -x "$VENV/bin/acestep-download" ]]; then
    echo "ACE-Step is not installed. Run '$0 install' first." >&2
    exit 1
  fi
}

download_core_models() {
  require_downloader
  # Core includes Turbo, VAE, text encoder, and the 1.7B planner. It is enough
  # for the default iterate workflow: generate, cover, and repaint.
  "$VENV/bin/acestep-download" --dir "$ROOT/checkpoints"
}

download_standard_models() {
  download_core_models
  # SFT enables polish; base enables extract, lego, complete, and LoRA.
  "$VENV/bin/acestep-download" --dir "$ROOT/checkpoints" --model acestep-v15-sft --skip-main
  "$VENV/bin/acestep-download" --dir "$ROOT/checkpoints" --model acestep-v15-base --skip-main
}

download_models() {
  download_standard_models
  # XL is optional at runtime but included by the full bootstrap so every
  # profile exposed by Lyre is available after one command.
  "$VENV/bin/acestep-download" --dir "$ROOT/checkpoints" --model acestep-v15-xl-turbo --skip-main
}

doctor() {
  local failures=0

  doctor_ok() { printf '  [ok]   %s\n' "$1"; }
  doctor_warn() { printf '  [warn] %s\n' "$1"; }
  doctor_fail() {
    printf '  [fail] %s\n' "$1"
    failures=$((failures + 1))
  }

  echo "Wizard's Lyre readiness check"
  if command -v git >/dev/null 2>&1; then doctor_ok "git $(git --version | awk '{print $3}')"; else doctor_fail "git is missing"; fi
  if command -v uv >/dev/null 2>&1; then doctor_ok "$(uv --version)"; else doctor_fail "uv is missing"; fi

  if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
    local node_version node_major node_minor
    node_version="$(node --version)"
    IFS=. read -r node_major node_minor _ <<<"${node_version#v}"
    if ((node_major == 20 && node_minor >= 19)) || ((node_major == 22 && node_minor >= 12)) || ((node_major > 22)); then
      doctor_ok "Node.js ${node_version#v}"
    else
      doctor_fail "Node.js ${node_version#v} is too old (need 20.19+ or 22.12+)"
    fi
  else
    doctor_fail "Node.js and npm are required"
  fi

  if [[ -x "$VENV/bin/python" ]]; then doctor_ok "Python $("$VENV/bin/python" --version 2>&1 | awk '{print $2}') environment"; else doctor_fail ".venv is missing; run '$0 install'"; fi
  if [[ -d "$ACE_DIR/.git" ]] && [[ "$(git -C "$ACE_DIR" rev-parse HEAD 2>/dev/null || true)" == "$ACE_REVISION" ]]; then
    doctor_ok "ACE-Step source is at the pinned revision"
  else
    doctor_fail "ACE-Step source is missing or not at the pinned revision"
  fi
  if [[ -f "$ROOT/web/dist/index.html" ]]; then doctor_ok "production web bundle"; else doctor_fail "web bundle is missing; run '$0 build-web'"; fi

  local model label
  while IFS='|' read -r model label; do
    if [[ -f "$ROOT/checkpoints/$model/model.safetensors" ]]; then
      doctor_ok "$label model"
    else
      doctor_warn "$label model is not downloaded"
    fi
  done <<'EOF'
acestep-v15-turbo|iterate
acestep-v15-sft|polish
acestep-v15-base|studio_ops
acestep-v15-xl-turbo|quality
EOF

  if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
    doctor_ok "$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader | head -n 1)"
  else
    doctor_warn "NVIDIA GPU is unavailable (the mock worker still works)"
  fi
  if command -v ffmpeg >/dev/null 2>&1; then doctor_ok "FFmpeg (style-pack training)"; else doctor_warn "FFmpeg is missing; style-pack training will not work"; fi

  if ((failures)); then
    printf '\n%d required check(s) failed. See docs/INSTALLATION.md.\n' "$failures" >&2
    return 1
  fi
  echo
  echo "Required checks passed. Warnings only affect the named optional capabilities."
}

usage() {
  cat <<EOF
Usage: ./scripts/lyre <command>

Commands:
  bootstrap  Install dependencies, build the web app, and download every
             ACE-Step model profile Lyre exposes into this checkout.
  install    Install dependencies and build the web app, without model files.
  models     Download or resume ACE-Step model downloads only.
  models-core
             Download the default iterate profile only (~9 GB).
  models-standard
             Download every profile except optional XL quality (~19 GB).
  server     Start Lyre's HTTP server on 127.0.0.1:8421.
  worker     Start Lyre's local GPU worker.
  web        Start the frontend development server.
  build-web  Build the frontend bundle served by the HTTP server.
  test       Run the Python test suite.
  test-web   Run the frontend test suite.
  lint       Check formatting and lint both stacks (and the launcher).
  audit      Check installed Python and locked frontend dependencies.
  format     Reformat both stacks in place.
  smoke-gpu  Run the manual ACE-Step GPU smoke test.
  live-check Run the end-to-end check against a running server and worker.
  doctor     Check tools, local install, models, GPU, and optional FFmpeg.
  paths      Print the project-local writable paths.
EOF
}

prepare_environment
cd "$ROOT"

case "${1:-}" in
  bootstrap)
    ensure_ace_source
    install_dependencies
    install_web
    download_models
    ;;
  install)
    ensure_ace_source
    install_dependencies
    install_web
    ;;
  models)
    download_models
    ;;
  models-core)
    download_core_models
    ;;
  models-standard)
    download_standard_models
    ;;
  server)
    ensure_venv
    exec "$VENV/bin/python" -m server.app
    ;;
  worker)
    ensure_venv
    exec "$VENV/bin/python" -m worker.run_worker
    ;;
  web)
    need_node
    exec npm --prefix "$ROOT/web" run dev
    ;;
  build-web)
    install_web
    ;;
  test)
    ensure_venv
    exec "$VENV/bin/python" -m pytest
    ;;
  test-web)
    need_command npm
    exec npm --prefix "$ROOT/web" test
    ;;
  lint)
    ensure_venv
    need_command npm
    "$VENV/bin/ruff" check .
    "$VENV/bin/ruff" format --check .
    "$VENV/bin/mypy"
    "$VENV/bin/reuse" lint
    npm --prefix "$ROOT/web" run lint
    # Optional system tool: skip the launcher lint rather than fail without it.
    if command -v shellcheck >/dev/null 2>&1; then
      shellcheck "$ROOT/scripts/lyre"
    else
      echo "shellcheck not installed; skipping the launcher lint." >&2
    fi
    ;;
  audit)
    ensure_venv
    need_node
    # These advisories require attacker-controlled model/checkpoint/cache files
    # or build paths that Lyre never accepts. See docs/SECURITY_AUDIT.md for the
    # reachability analysis and review rule. Any new advisory still fails.
    "$VENV/bin/pip-audit" --progress-spinner=off \
      --ignore-vuln PYSEC-2026-2447 \
      --ignore-vuln PYSEC-2026-3624 \
      --ignore-vuln PYSEC-2025-217 \
      --ignore-vuln PYSEC-2026-2288 \
      --ignore-vuln PYSEC-2026-2289 \
      --ignore-vuln PYSEC-2026-2290 \
      --ignore-vuln CVE-2026-9856 \
      --ignore-vuln PYSEC-2025-49 \
      --ignore-vuln PYSEC-2026-3447
    npm audit --audit-level=moderate --prefix "$ROOT/web"
    ;;
  format)
    ensure_venv
    need_command npm
    "$VENV/bin/ruff" format .
    "$VENV/bin/ruff" check --fix .
    npm --prefix "$ROOT/web" run format
    ;;
  smoke-gpu)
    ensure_venv
    exec "$VENV/bin/python" scripts/smoke-gpu.py
    ;;
  live-check)
    ensure_venv
    shift
    exec "$VENV/bin/python" scripts/live_stack_check.py "$@"
    ;;
  doctor)
    doctor
    ;;
  paths)
    cat <<EOF
root:        $ROOT
venv:        $VENV
ACE-Step:    $ACE_DIR
models:      $ROOT/checkpoints
projects:    $ROOT/projects
output:      $ROOT/output
caches:      $ROOT/.cache
config:      $ROOT/.config
temporary:   $ROOT/.tmp
EOF
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
